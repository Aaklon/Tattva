global activeView = "Overview"

fn showOverview() {
  activeView = "Overview"
}

fn showActivity() {
  activeView = "Activity"
}

page "/examples/dashboard" {
  main(class: "min-h-screen bg-stone-100 p-4 sm:p-8") {
    div(class: "mx-auto grid max-w-7xl gap-5 lg:grid-cols-[230px_1fr]") {
      aside(class: "rounded-3xl bg-slate-950 p-6 text-white shadow-xl") {
        div(class: "flex items-center gap-3") {
          span(class: "grid h-10 w-10 place-items-center rounded-xl bg-lime-300 text-lg font-semibold text-slate-950") "T"
          strong(class: "text-lg") "तत्त्व:"
        }
        div(class: "mt-3 space-y-2") {
          button(class: "w-full rounded-xl bg-white/10 px-4 py-3 text-left text-sm font-medium", onclick: showOverview) "◫ Overview"
          button(class: "w-full rounded-xl px-4 py-3 text-left text-sm font-medium text-slate-400 hover:bg-white/10 hover:text-white", onclick: showActivity) "↻ Activity"
        }
      }
      section(class: "min-w-0 rounded-3xl bg-white p-6 shadow-xl sm:p-9") {
        div(class: "flex flex-wrap items-end justify-between gap-4") {
          div {
            h1(class: "mt-2 text-3xl font-semibold text-slate-900") "{activeView}, Mira"
          }
          span(class: "rounded-full bg-emerald-50 px-4 py-2 text-xs font-medium text-emerald-700") "● All systems normal"
        }
        div(class: "mt-8 grid gap-4 sm:grid-cols-3") {
          article(class: "rounded-2xl bg-green-50 p-5") {
            p(class: "text-sm font-semibold text-green-700") "Projects"
            strong(class: "mt-3 block text-4xl font-semibold text-slate-900") "12"
            small(class: "text-slate-500") "+2 this month"
          }
          article(class: "rounded-2xl bg-emerald-50 p-5") {
            p(class: "text-sm font-semibold text-emerald-700") "Tasks done"
            strong(class: "mt-3 block text-4xl font-semibold text-slate-900") "84"
            small(class: "text-slate-500") "Looking productive"
          }
          article(class: "rounded-2xl bg-amber-50 p-5") {
            p(class: "text-sm font-semibold text-amber-700") "Focus hours"
            strong(class: "mt-3 block text-4xl font-semibold text-slate-900") "26"
            small(class: "text-slate-500") "Take a stretch break"
          }
        }
        h2(class: "mt-9 text-lg font-semibold text-slate-900") "Recent activity"
        div(class: "mt-4 divide-y divide-slate-100") {
          div(class: "flex items-center gap-4 py-4") {
            span(class: "grid h-10 w-10 place-items-center rounded-xl bg-green-100 text-green-700") "✦"
            div(class: "flex-1") {
              strong(class: "block text-sm") "Homepage refresh"
              small(class: "text-slate-500") "Design review complete"
            }
            small(class: "text-slate-400") "10 min ago"
          }
          div(class: "flex items-center gap-4 py-4") {
            span(class: "grid h-10 w-10 place-items-center rounded-xl bg-emerald-100 text-emerald-700") "✓"
            div(class: "flex-1") {
              strong(class: "block text-sm") "Docs published"
              small(class: "text-slate-500") "The new guide is live"
            }
            small(class: "text-slate-400") "Yesterday"
          }
        }
      }
    }
    section(class: "example-source-panel") {
      h2 "Tattva source"
      pre { code(id: "source-dashboard") "Loading source..." }
    }
  }
}
