global taskText = ""
global tasks = [
  { title: "Read the variables chapter", done: true },
  { title: "Build one small Tattva page", done: false },
  { title: "Celebrate the first compile", done: false }
]
global taskCount = 3

fn addTask() {
  if taskText != "" {
    tasks.push({ title: taskText, done: false })
    tasks = tasks
    taskCount = taskCount + 1
    taskText = ""
  }
}

fn markTaskDone(taskTitle) {
  for task in tasks {
    if task.title == taskTitle {
      task.done = true
    }
  }
  tasks = tasks
}

page "/examples/todo-list" {
  main(class: "min-h-screen bg-green-50 px-5 py-14") {
    section(class: "mx-auto max-w-xl rounded-3xl bg-white p-7 shadow-xl sm:p-9") {
      div(class: "flex items-start justify-between gap-4") {
        div {
          h1(class: "mt-3 text-3xl font-semibold text-slate-900") "One thing at a time."
          p(class: "mt-2 text-sm text-slate-500") "A tiny task list with bound input and reactive rows."
        }
        span(class: "rounded-2xl bg-green-100 px-4 py-3 text-center") {
          strong(class: "block text-2xl text-green-800") "{taskCount}"
          small(class: "text-xs font-medium uppercase text-green-700") "tasks"
        }
      }
      div(class: "mt-8 flex gap-2") {
        input(class: "min-w-0 flex-1 rounded-xl border border-slate-200 px-4 py-3 outline-none focus:border-green-600 focus:ring-4 focus:ring-green-100", bind: taskText, placeholder: "Add a task")
        button(class: "rounded-xl bg-green-700 px-5 font-medium text-white hover:bg-green-800", onclick: addTask) "+ Add"
      }
      ul(class: "mt-6 space-y-3") {
        for task in tasks {
          li(class: "flex items-center gap-3 rounded-xl border border-slate-100 p-4") {
            if task.done {
              span(class: "grid h-6 w-6 place-items-center rounded-full bg-emerald-100 text-sm font-semibold text-emerald-700") "✓"
            } else {
              span(class: "grid h-6 w-6 place-items-center rounded-full bg-slate-100 text-sm font-semibold text-slate-400") "·"
            }
            span(class: "flex-1 text-sm font-semibold text-slate-700") "{task.title}"
            if task.done {
              span(class: "rounded-full bg-emerald-50 px-3 py-1 text-[10px] font-semibold uppercase tracking-wide text-emerald-700") "DONE"
            } else {
              button(class: "rounded-lg bg-amber-50 px-3 py-2 text-[10px] font-semibold uppercase tracking-wide text-amber-700 hover:bg-amber-100", onclick: () -> markTaskDone(task.title)) "Mark done"
            }
          }
        }
      }
    }
    section(class: "example-source-panel") {
      h2 "Tattva source"
      pre { code(id: "source-todo-list") "Loading source..." }
    }
  }
}
