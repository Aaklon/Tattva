app {
  title: "Signup Form"
}

script "https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"

global fullName = ""
global emailAddress = ""
global submitted = false

fn submitForm() {
  submitted = true
}

page "/" {
  main(class: "flex min-h-screen w-full min-w-0 flex-col items-center justify-center gap-8 bg-gradient-to-br from-green-100 via-white to-lime-100 px-4 py-8 sm:px-6") {
    section(class: "w-full max-w-xl min-w-0 rounded-3xl bg-white p-5 shadow-xl sm:p-8 md:p-10") {
      h1(class: "mt-5 text-3xl font-semibold text-slate-900 sm:text-4xl") "Get the good updates."
      if submitted {
        div(class: "mt-7 rounded-2xl border border-emerald-200 bg-emerald-50 p-5 text-emerald-900") {
          strong(class: "text-lg") "You're on the list, {fullName}."
          p(class: "mt-1 text-sm") "The confirmation is local to this demo. Nothing was sent."
        }
      } else {
        div(class: "mt-8 space-y-5") {
          label(class: "block text-sm font-medium text-slate-700") {
            span(class: "mb-2 block") "Your name"
            input(class: "w-full rounded-xl border border-slate-300 px-4 py-3 text-base outline-none transition focus:border-green-600 focus:ring-4 focus:ring-green-100", bind: fullName, placeholder: "Asha Rao")
          }
          label(class: "block text-sm font-medium text-slate-700") {
            span(class: "mb-2 block") "Email address"
            input(type: "email", class: "w-full rounded-xl border border-slate-300 px-4 py-3 text-base outline-none transition focus:border-green-600 focus:ring-4 focus:ring-green-100", bind: emailAddress, placeholder: "asha@example.com")
          }
          button(class: "w-full rounded-xl bg-green-700 px-5 py-4 font-medium text-white shadow-lg transition hover:bg-green-800", onclick: submitForm) "Join the list"
        }
      }
    }
  }
}
